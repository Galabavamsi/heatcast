FORTYGUARD_API_KEY=your_api_key_here
FORTYGUARD_BASE_URL=https://api.fortyguard.com
# Bind 0.0.0.0:$PORT (Railway / Fly / any host that injects PORT)
PORT=8000
# Comma-separated extra CORS origins. localhost and https://*.vercel.app are always allowed.
# CORS_ORIGINS=https://heatcast.vercel.app
# Optional planner brief (server-side only). If unset, a template memo is used.
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-v4-flash
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
